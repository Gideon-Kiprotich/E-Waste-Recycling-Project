APP_NAME="Smart E-Waste Collection, Tracking and Recycling Management Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

ARGON_MEMORY=65536
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ewaste_development
DB_USERNAME=ewaste_app
DB_PASSWORD=replace-with-local-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Keep log delivery until a provider is configured privately. Optional SMTP template:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.provider.example
# MAIL_PORT=587
# MAIL_USERNAME=replace-with-provider-username
# MAIL_PASSWORD=replace-with-provider-secret
# MAIL_FROM_ADDRESS=verified-sender@example.test
# Use the provider's scheme/port; implicit TLS commonly uses smtps/465.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public map settings; never put private API keys in browser-visible tile URLs.
PICKUP_MAP_ENABLED=true
PICKUP_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
PICKUP_MAP_ATTRIBUTION_TEXT="© OpenStreetMap contributors"
PICKUP_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
